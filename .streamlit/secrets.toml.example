# Streamlit Community Cloud > 앱 > Settings > Secrets 에 아래 내용을 값만 바꿔 붙여넣습니다.
# 이 파일은 예시입니다. 실제 비밀번호를 GitHub에 올리지 마세요.
DATA_BACKEND = "db"

# AI 분석가·Growth Lab AI 초안: OpenAI(GPT) 키. 실제 키는 Streamlit Secrets와 PC의 .streamlit/secrets.toml에만 넣습니다.
# OPENAI_API_KEY = "sk-...여기에 붙여넣기"
# OPENAI_MODEL = "gpt-5-nano"   # 모델을 고정하고 싶을 때만 (없으면 가장 가벼운 nano 최신 버전 자동 선택)

# Supabase > Project > Connect > "Session pooler" 의 값을 사용하세요 (Streamlit Cloud는 IPv4만 지원).
DB_HOST = "aws-0-ap-northeast-2.pooler.supabase.com"
DB_PORT = "5432"
DB_NAME = "postgres"
DB_USER = "postgres.프로젝트ID"
DB_PASSWORD = "비밀번호"
DB_SSLMODE = "require"
