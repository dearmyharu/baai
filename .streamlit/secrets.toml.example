# Streamlit Community Cloud > 앱 > Settings > Secrets 에 아래 내용을 값만 바꿔 붙여넣습니다.
# 이 파일은 예시입니다. 실제 비밀번호를 GitHub에 올리지 마세요.
DATA_BACKEND = "db"

# Supabase > Project > Connect > "Session pooler" 의 값을 사용하세요 (Streamlit Cloud는 IPv4만 지원).
DB_HOST = "aws-0-ap-northeast-2.pooler.supabase.com"
DB_PORT = "5432"
DB_NAME = "postgres"
DB_USER = "postgres.프로젝트ID"
DB_PASSWORD = "비밀번호"
DB_SSLMODE = "require"
